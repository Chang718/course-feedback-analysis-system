{
  "ui_acceptance": {
    "sections": [
      "hero",
      "form",
      "summary",
      "feedback_list"
    ],
    "image_required": true,
    "summary_cards": [
      "total_feedback",
      "average_rating",
      "positive_ratio",
      "top_category"
    ]
  },
  "api_acceptance": {
    "required_endpoints": [
      "/api/health",
      "/api/feedback",
      "/api/summary"
    ],
    "required_fields": [
      "course_name",
      "instructor_name",
      "rating",
      "category",
      "feedback_text"
    ]
  },
  "interaction_flow": [
    "Open single-page website",
    "Submit feedback with all required fields",
    "Show confirmation after submission",
    "Refresh summary metrics and feedback list"
  ],
  "traceability": {
    "page_section_mapping": {
      "hero": "Display app title and description",
      "form": "Input form for submitting course feedback",
      "summary": "Show aggregated summary of all feedback (e.g., average rating per category)",
      "feedback_list": "List all submitted feedback entries"
    },
    "endpoint_mapping": [
      {
        "path": "/api/health",
        "method": "GET",
        "purpose": "Health check to verify server is running"
      },
      {
        "path": "/api/feedback",
        "method": "GET",
        "purpose": "Retrieve all feedback entries"
      },
      {
        "path": "/api/feedback",
        "method": "POST",
        "purpose": "Submit new feedback entry"
      },
      {
        "path": "/api/summary",
        "method": "GET",
        "purpose": "Retrieve aggregated summary of feedback by category"
      }
    ]
  }
}