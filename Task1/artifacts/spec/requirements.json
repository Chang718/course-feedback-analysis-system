{
  "requirements": [
    "Single-page application",
    "No login required",
    "Submit feedback via form",
    "View aggregated summary",
    "View list of feedback",
    "Support for five categories: Teaching, Assessment, Materials, Pace, Engagement",
    "Feedback fields: course_name, instructor_name, rating, category, feedback_text",
    "Health check endpoint",
    "Feedback endpoints (GET and POST)",
    "Summary endpoint (GET)"
  ],
  "data_fields": [
    {
      "name": "course_name",
      "type": "string",
      "required": true
    },
    {
      "name": "instructor_name",
      "type": "string",
      "required": true
    },
    {
      "name": "rating",
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    {
      "name": "category",
      "type": "string",
      "enum": [
        "Teaching",
        "Assessment",
        "Materials",
        "Pace",
        "Engagement"
      ],
      "required": true
    },
    {
      "name": "feedback_text",
      "type": "string",
      "required": true
    }
  ],
  "page_section_mapping": {
    "hero": "Display app title and description",
    "form": "Input form for submitting course feedback",
    "summary": "Show aggregated summary of all feedback (e.g., average rating per category)",
    "feedback_list": "List all submitted feedback entries"
  },
  "endpoint_mapping": [
    {
      "path": "/api/health",
      "method": "GET",
      "purpose": "Health check to verify server is running"
    },
    {
      "path": "/api/feedback",
      "method": "GET",
      "purpose": "Retrieve all feedback entries"
    },
    {
      "path": "/api/feedback",
      "method": "POST",
      "purpose": "Submit new feedback entry"
    },
    {
      "path": "/api/summary",
      "method": "GET",
      "purpose": "Retrieve aggregated summary of feedback by category"
    }
  ]
}